   "source": [
    "def recommend_similar_movies_with_input(movie_name, movie_encoder, movie_factors, top_n=10):\n",
    "\n",
    "    movie_name = movie_name.lower().strip()\n",
    "    all_titles = list(movie_encoder.classes_)\n",
    "\n",
    "    partial_matches = [title for title in all_titles if movie_name in title.lower()]\n",
    "    if partial_matches:\n",
    "        best_match = partial_matches[0]\n",
    "    else:\n",
    "        close_matches = difflib.get_close_matches(movie_name, all_titles, n=1, cutoff=0.3)\n",
    "        if not close_matches:\n",
    "            print(f\"No match found for '{movie_name}'.\")\n",
    "            return pd.DataFrame()\n",
    "        best_match = close_matches[0]\n",
    "\n",
    "    print(f\"Closest match found: '{best_match}'\")\n",
    "\n",
    "    try:\n",
    "        movie_idx = movie_encoder.transform([best_match])[0]\n",
    "    except:\n",
    "        print(f\"Matched movie '{best_match}' could not be encoded.\")\n",
    "        return pd.DataFrame()\n",
    "\n",
    "    input_vector = movie_factors[movie_idx].reshape(1, -1)\n",
    "    similarities = cosine_similarity(input_vector, movie_factors).flatten()\n",
    "\n",
    "    similar_indices = similarities.argsort()[::-1][1:top_n + 1]\n",
    "\n",
    "    max_valid_index = len(movie_encoder.classes_) - 1\n",
    "    valid_indices = [i for i in similar_indices if i <= max_valid_index]\n",
    "    valid_scores = [similarities[i] for i in valid_indices]\n",
    "\n",
    "    similar_titles = movie_encoder.inverse_transform(valid_indices)\n",
    "\n",
    "    result_titles = [best_match] + list(similar_titles)\n",
    "    result_scores = [1.0] + valid_scores\n",
    "\n",
    "    return pd.DataFrame({\n",
    "        'title': result_titles,\n",
    "        'similarity_score': result_scores\n",
    "})"
   ]
  },
